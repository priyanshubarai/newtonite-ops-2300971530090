# Base URL for the backend API.
#
# The recommended development value is the same-origin `/api` prefix: Vite
# (see vite.config.ts) proxies `/api/*` to http://localhost:3000 and strips the
# prefix, which avoids cross-origin requests entirely. Set a full URL only when
# the API is served from a different origin (that origin must then send CORS
# headers).
VITE_API_URL=/api
