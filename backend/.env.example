# Neon PostgreSQL connection string (supplied by the developer).
# Leave empty here - copy this file to .env and paste your real Neon URL.
# Format: postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require
DATABASE_URL=

NODE_ENV=development
PORT=3000

# Secret used to sign short-lived auth tokens (JWT). Generate a strong random
# value for your environment. Leave blank here - never commit a real secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: auth token lifetime in seconds (default 900 = 15 minutes).
JWT_EXPIRES_IN=900

# Optional: transactional-outbox worker tuning (Phase 8). The worker runs with
# sensible defaults, so none of these are required. They are only read by
# `npm run worker`; the HTTP API ignores them.
# Maximum jobs claimed per poll (default 10).
OUTBOX_BATCH_SIZE=10
# Delay between polls, in milliseconds (default 2000).
OUTBOX_POLL_INTERVAL_MS=2000
# First retry delay in milliseconds; doubles with jitter per attempt (default 5000).
OUTBOX_BACKOFF_BASE_MS=5000
# Retry delay ceiling in milliseconds (default 300000 = 5 minutes).
OUTBOX_BACKOFF_MAX_MS=300000
# How long a claimed job may stay PROCESSING before it is treated as abandoned
# and made eligible again, in milliseconds (default 60000 = 1 minute).
OUTBOX_LEASE_TIMEOUT_MS=60000

# Optional: demo password for seeded users (development only; default: newtonite-demo).
DEMO_PASSWORD=

